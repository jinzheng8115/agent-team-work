{
  "schema_version": "1.0",
  "profile": "runtime-only",
  "description": "Files required by the Agent Team Work skill at runtime, including generated target adapters. Development, evaluation, audit, and release evidence remain source-only; two tiny portable integrity metadata files are retained for archive verification.",
  "include": [
    "LICENSE",
    "SKILL.md",
    "manifest.json",
    "agents/interface.yaml",
    "agents/openai.yaml",
    "reports/.current-run.json",
    "reports/artifact-index.json",
    "references/codex-tools.md",
    "references/role-capabilities.md",
    "references/role-presets.md",
    "references/team-protocol.md",
    "references/team-scaling.md",
    "references/workflow.md",
    "targets/claude/README.md",
    "targets/claude/adapter.json",
    "targets/generic/adapter.json",
    "targets/openai/adapter.json",
    "targets/openai/agents/openai.yaml",
    "targets/vscode/README.md",
    "targets/vscode/adapter.json"
  ],
  "generated_roots": [
    "targets"
  ],
  "target_files": [
    "targets/claude/README.md",
    "targets/claude/adapter.json",
    "targets/generic/adapter.json",
    "targets/openai/adapter.json",
    "targets/openai/agents/openai.yaml",
    "targets/vscode/README.md",
    "targets/vscode/adapter.json"
  ],
  "excluded_roots": [
    "docs",
    "evidence",
    "evals",
    "examples",
    "failures",
    "registry",
    "reports",
    "scripts",
    "security",
    "skill-ir",
    "skill_atlas"
  ],
  "integrity_files": [
    "reports/.current-run.json",
    "reports/artifact-index.json"
  ]
}
